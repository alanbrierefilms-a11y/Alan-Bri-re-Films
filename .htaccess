# --- Alan Brière Films - performance & basic hardening -----------------

# Compression (Gzip/Brotli via mod_deflate, most Hostinger plans have this module)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: revalidate often, content changes
  ExpiresByType text/html "access plus 0 seconds"

  # CSS / JS
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video
  ExpiresByType video/mp4 "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Force HTTPS and the www-less canonical host
# (checks X-Forwarded-Proto too: on hosts that terminate SSL on a proxy in front
# of Apache, %{HTTPS} alone stays "off" even over a real https:// connection,
# which causes an infinite redirect loop - the site intermittently refusing to
# open on mobile).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.alanbrierefilms\.fr$ [NC]
  RewriteRule ^(.*)$ https://alanbrierefilms.fr/$1 [L,R=301]
</IfModule>

# Custom 404 page (create assets/404.html if you want a branded one; falls back to host default otherwise)
# ErrorDocument 404 /404.html
